{
    "scripts": {
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cd backend && npm start",
        "dev:frontend": "wait-on tcp:127.0.0.1:8080 && cd frontend && npm run dev"

    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "wait-on": "^8.0.1"
    }
}
